# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.
SENDER_EMAIL=your_gmail_address@gmail.com
# Google Account > Security > 2-Step Verification > App passwords (16 characters)
SENDER_APP_PASSWORD=your_16_char_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Recipient for the daily report email (defaults to SENDER_EMAIL if empty)
TEST_RECIPIENT_EMAIL=another_email@example.com
# Email-to-SMS gateway (US carriers: att, verizon, tmobile, sprint, boost)
TEST_SMS_PHONE_NUMBER=1234567890
TEST_SMS_CARRIER=att

# true = save emails to outbox/ instead of sending
DRY_RUN=false
