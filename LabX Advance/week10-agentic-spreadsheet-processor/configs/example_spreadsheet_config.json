{
    "input_file": "data/input_data.xlsx",
    "output_file": "data/output_report.xlsx",
    "tasks": [
        {
            "type": "copy_data",
            "source_sheet": "SalesData",
            "dest_sheet": "Raw Data"
        },
        {
            "type": "calculate_column",
            "sheet": "Raw Data",
            "target_column": "D",
            "header": "Total Revenue",
            "start_row": 2,
            "formula": "=B{row}*C{row}",
            "number_format": "#,##0.00"
        },
        {
            "type": "conditional_format",
            "sheet": "Raw Data",
            "range": "D2:D100",
            "rule_type": "color_scale",
            "min_color": "F8696B",
            "mid_color": "FFEB84",
            "max_color": "63BE7B"
        },
        {
            "type": "calculate_column",
            "sheet": "Raw Data",
            "target_column": "E",
            "header": "Status",
            "start_row": 2,
            "formula": "=IF(D{row}>1000,\"High Value\",\"Standard\")"
        },
        {
            "type": "conditional_format",
            "sheet": "Raw Data",
            "range": "E2:E100",
            "rule_type": "expression",
            "formula": "=$E2=\"High Value\"",
            "fill_color": "92D050",
            "font_color": "000000"
        },
        {
            "type": "data_validation",
            "sheet": "Raw Data",
            "target_column": "F",
            "header": "Review Status",
            "options": ["Pending", "Approved", "Rejected"],
            "default": "Pending"
        },
        {
            "type": "chart",
            "sheet": "Raw Data",
            "chart_type": "bar",
            "data_range": "D1:D10",
            "category_range": "A2:A10",
            "title": "Revenue by Product",
            "x_axis_title": "Product",
            "y_axis_title": "Revenue",
            "top_left_cell": "H2"
        },
        {
            "type": "summary_sheet",
            "sheet": "Summary",
            "source_sheet": "Raw Data",
            "metrics": [
                {"label": "Number of Products", "formula": "=COUNT({src}!B2:B{last})"},
                {"label": "Total Quantity Sold", "formula": "=SUM({src}!B2:B{last})"},
                {"label": "Total Revenue", "formula": "=SUM({src}!D2:D{last})", "number_format": "#,##0.00"},
                {"label": "Average Revenue per Product", "formula": "=AVERAGE({src}!D2:D{last})", "number_format": "#,##0.00"},
                {"label": "Highest Revenue", "formula": "=MAX({src}!D2:D{last})", "number_format": "#,##0.00"},
                {"label": "Top Product", "formula": "=INDEX({src}!A2:A{last},MATCH(MAX({src}!D2:D{last}),{src}!D2:D{last},0))"},
                {"label": "High Value Products (>1000)", "formula": "=COUNTIF({src}!E2:E{last},\"High Value\")"}
            ]
        }
    ]
}
